---
import RegionLayoutUK from '../../layouts/RegionLayoutUK.astro';
import HeroUK from '../../components/HeroUK.astro';
import TrustRow from '../../components/TrustRow.astro';
import WhoThisIsFor from '../../components/WhoThisIsFor.astro';
import WhyThisWorks from '../../components/WhyThisWorks.astro';
import ExamplesGalleryUK from '../../components/ExamplesGalleryUK.astro';
import TypicalResults from '../../components/TypicalResults.astro';
import GoogleBusinessProfile from '../../components/GoogleBusinessProfile.astro';
import HowItWorksUK from '../../components/HowItWorksUK.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQAccordionUK from '../../components/FAQAccordionUK.astro';
import ContactFormUK from '../../components/ContactFormUK.astro';

const region = 'uk';
---

<RegionLayoutUK
  title="Professional Websites for UK Service Businesses"
  description="Bespoke websites for UK tradespeople and local service businesses. Built to generate enquiries. Start a conversation with our UK-based team."
  region={region}
>
  <HeroUK region={region} />
  <TrustRow />
  <WhoThisIsFor />
  <WhyThisWorks />
  <ExamplesGalleryUK />
  <TypicalResults />
  <GoogleBusinessProfile />
  <HowItWorksUK />
  <Testimonials region={region} />
  <FAQAccordionUK />
  <ContactFormUK region={region} />
</RegionLayoutUK>
