---
import RegionLayoutUK from '../../layouts/RegionLayoutUK.astro';
import ExamplesGalleryUK from '../../components/ExamplesGalleryUK.astro';
import Button from '../../components/Button.astro';

import { getBasePath } from '../../utils/basePath';

const region = 'uk';
const basePath = getBasePath();
---

<RegionLayoutUK
  title="Example Projects"
  description="View example website projects built for UK service businesses. Real websites for tradespeople, local services, and small businesses."
  region={region}
>
  <section class="py-20 bg-bg-base section-fade-in">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold font-heading text-text-primary mb-6 heading-reveal">
        Real UK <span class="gradient-text heading-underline">service business</span> websites
      </h1>
      <p class="text-xl text-text-secondary mb-4 heading-reveal anim-delay-1">
        Built and managed as part of the same offering. These are real businesses we've helped get online.
      </p>
    </div>
  </section>
  
  <ExamplesGalleryUK />
  
  <section class="py-20 bg-bg-elevated relative section-fade-in">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-primary/50 to-transparent"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold font-heading text-text-primary mb-4">
        Ready to get your own site?
      </h2>
      <p class="text-xl text-text-secondary mb-8">
        Whether you're a tradesperson, service provider, or local business, we can help.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={`${basePath}/${region}/contact`} variant="primary" size="lg">
          Tell us about your business
        </Button>
        <Button href={`${basePath}/${region}/how-it-works`} variant="secondary" size="lg">
          See how it works
        </Button>
      </div>
    </div>
  </section>
</RegionLayoutUK>
